# ---- Mini Shop SaaS — browser-visible development values only ---------------
# Copy to .env.local (gitignored) and fill from a NON-PRODUCTION Supabase
# environment for local development.
#
# VITE_* values are embedded into browser bundles. NEVER place a service-role
# key, webhook secret, private token, or other privileged credential here.

VITE_SUPABASE_URL=https://YOUR_NON_PRODUCTION_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# ---- Commercial packaging ---------------------------------------------------
# FALLBACK ONLY. shops.plan is authoritative.
# Valid values: free_trial | starter | business.
# Unknown, missing, or malformed values fail closed to free_trial.
# Production should normally leave this unset and use the database plan.
VITE_DEFAULT_PLAN=free_trial
