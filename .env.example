# ---- Mini Shop SaaS — frontend env (PUBLIC values only) --------------------
# Copy to .env.local (gitignored) and fill from your Supabase project settings.
# NEVER put the service_role key here — only the public anon key. RLS enforces
# access (see supabase/migrations/0001_init_saas.sql).

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# ---- Commercial packaging ---------------------------------------------------
# Deploy-wide default plan until per-shop plans exist (a `shops.plan` column,
# a Backend task). One of: starter | business. Defaults to `business` when
# unset, so an existing single-seller deploy keeps every feature.
#   - starter  : storefront, products, cart, checkout, basic order/shipping
#   - business : + promotions, per-township shipping, payment verification,
#                advanced dashboard, branding (logo), integration hooks
# NOTE: this is a deploy-wide default only — it is NOT per-seller and MUST NOT
# be treated as the source of truth once billing/plans land in the backend.
VITE_DEFAULT_PLAN=business
