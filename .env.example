# ---- Mini Shop SaaS — frontend env (PUBLIC values only) --------------------
# Copy to .env.local (gitignored) and fill from your Supabase project settings.
# NEVER put the service_role key here — only the public anon key. RLS enforces
# access (see supabase/migrations/0001_init_saas.sql).

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# ---- Commercial packaging ---------------------------------------------------
# FALLBACK ONLY. The source of truth is the `shops.plan` column (added in
# 0003_platform_plan_and_usage.sql, NOT NULL DEFAULT 'starter'), so this is read
# only for a shop with no row resolved yet. One of: starter | business.
#   - starter  : storefront, products, cart, checkout, basic order/shipping
#   - business : + promotions, per-township shipping, payment verification,
#                advanced dashboard, branding (logo), integration hooks
# Resolution FAILS CLOSED (src/domain/plan.ts): unset, unknown or malformed
# resolves to `starter` — a missing env var can never hand out paid features.
# Leave it unset in production; `shops.plan` decides, and 0007 enforces it in
# the database (a seller can never self-upgrade).
VITE_DEFAULT_PLAN=starter
